# Copy to .env.local and fill in. Leave unused keys EMPTY (never placeholder text).

# Public origin of the site (canonical URLs, Open Graph, JSON-LD, sitemap). Leave EMPTY: production builds fall back to
# https://www.littlebraincrew.com, local dev to http://localhost:3000. Set it only for another origin, e.g. a preview deploy.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Postgres (Supabase)
POSTGRES_HOST=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Creem (payments + affiliate program, lib/creem.ts). Empty = checkout and webhook answer 503, the site stays in preview.
# CREEM_LIVE: leave EMPTY to use Creem's test store (test-api.creem.io); only the exact value true switches to live money.
CREEM_API_KEY=
# Optional restricted key for the admin discount page (discounts:read + discounts:write).
# If empty, uses CREEM_API_KEY; that key must then have those permissions too. Must match CREEM_LIVE's store.
CREEM_DISCOUNTS_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_LIVE=

# Amazon SES (sending email, lib/email/send.ts). Keys of an IAM user that may only send (README: Email).
# Empty = emails are logged, not sent. SES_REGION defaults to eu-north-1, where littlebraincrew.com is verified.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=
# Optional: SES configuration set for bounce/complaint events.
SES_CONFIGURATION_SET=
# From defaults to "Little Brain Crew <hello@littlebraincrew.com>". Reply-To must be a real Hostinger mailbox.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Physical mailing address shown in every email footer (CAN-SPAM: required in list and marketing email, e.g. a PO box).
# Set it before the free list, stickers and challenge emails go out.
EMAIL_POSTAL_ADDRESS=


# Abandoned-checkout reminder (lib/checkout-reminders.ts). Vercel Cron sends CRON_SECRET as a Bearer token to
# /api/cron/checkout-reminders. Reminders stay off until CHECKOUT_REMINDERS=true (after the privacy policy mentions them).
CRON_SECRET=
CHECKOUT_REMINDERS=
