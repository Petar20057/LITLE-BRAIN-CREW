  "html": "<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\" focusable=\"false\">\n  <defs>\n    <symbol id=\"i-mail\" viewBox=\"0 0 24 24\"><path d=\"M3.5 6.2c5.6-.4 11.4-.5 17-.1.4 3.9.4 7.9 0 11.8-5.7.4-11.4.4-17 0-.4-3.9-.4-7.8 0-11.7z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M4 7c2.6 2.4 5.3 4.4 8 6 2.7-1.6 5.4-3.6 8-6.1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></symbol>\n    <symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><path d=\"M5.2 10.6c4.6-.3 9.1-.3 13.6 0 .3 3 .3 6 0 9-4.5.3-9 .3-13.6 0-.3-3-.3-6 0-9z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M8.2 10.4c-.2-2.8.6-6 3.9-6 3.2 0 4 3.1 3.8 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"15\" r=\"1.4\" fill=\"currentColor\"/></symbol>\n    <symbol id=\"i-ask\" viewBox=\"0 0 24 24\"><path d=\"M4 5.4c5.3-.6 10.7-.6 16 0 .5 3.3.5 6.6 0 9.9-2.7.3-5.3.4-8 .4L7.5 19.6l.3-4.1c-1.3 0-2.5-.1-3.8-.2-.5-3.3-.5-6.6 0-9.9z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/><path d=\"M10 8.6c.5-1.4 3.6-1.5 3.9.3.2 1.4-1.9 1.6-1.9 3\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><circle cx=\"12\" cy=\"13.6\" r=\"1\" fill=\"currentColor\"/></symbol>\n    <symbol id=\"i-gift\" viewBox=\"0 0 24 24\"><path d=\"M4.4 10c5-.3 10.1-.3 15.2 0 .2 3.3.2 6.6 0 9.9-5 .3-10.1.3-15.2 0-.2-3.3-.2-6.6 0-9.9zM3.6 7.2c5.6-.3 11.2-.3 16.8 0 .1 1 .1 1.9 0 2.8M12 7.2v12.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 7c-1.6-2.8-5.4-3.4-5-.9.3 1.6 3.4 1.2 5 .9 1.6-2.8 5.4-3.4 5-.9-.3 1.6-3.4 1.2-5 .9z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></symbol>\n    <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M4.5 12.8c1.6 1.3 3 2.8 4.3 4.6 3-4.6 6.4-8.6 10.6-11.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  </defs>\n</svg>\n\n<div class=\"progress\" aria-hidden=\"true\"><i id=\"progress\"></i></div>\n<header class=\"top\">\n  <div class=\"wrap\">\n    <a href=\"/\" class=\"logo\" aria-label=\"Little Brain Crew home\"><img class=\"logo-img on-light\" src=\"/assets/brand/lbc-logo-horizontal.svg\" alt=\"\" width=\"133\" height=\"48\"><img class=\"logo-img on-dark\" src=\"/assets/brand/lbc-logo-horizontal-white.svg\" alt=\"\" width=\"133\" height=\"48\"></a>\n    <nav class=\"learn-nav\" aria-label=\"Learn\">\n      <a href=\"/crew\">Meet the crew</a>\n      <a href=\"/why\">Why does my kid…</a>\n      <a href=\"/what-to-say\">What to say</a>\n      <a href=\"/myths\">Myths</a>\n      <a href=\"/learn\">All guides</a>\n    </nav>\n    <details class=\"learn-menu\">\n      <summary>Learn</summary>\n      <div class=\"learn-pop\">\n        <a href=\"/crew\">Meet the crew</a>\n        <a href=\"/why\">Why does my kid…</a>\n        <a href=\"/what-to-say\">What to say</a>\n        <a href=\"/myths\">Myths</a>\n        <a href=\"/learn\">All guides</a>\n      </div>\n    </details>\n    <div class=\"top-right\">\n      <div class=\"toggle\" role=\"group\" aria-label=\"I am a\">\n        <button type=\"button\" aria-pressed=\"true\" data-who=\"mom\"><span class=\"long\">I’m a </span>mom</button>\n        <button type=\"button\" aria-pressed=\"false\" data-who=\"dad\"><span class=\"long\">I’m a </span>dad</button>\n      </div>\n      <a href=\"/#plans\" class=\"btn btn-main\">See the plans</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<section class=\"sec lazy-sec s-plain\" id=\"reviews\" data-c=\"var(--toci)\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\"><h2>What parents say</h2></div>\n    <p class=\"honest\">We’re new. We have no reviews yet, and we won’t make any up.</p>\n    <div class=\"found\">\n      <div>\n        <span class=\"kick\">founding parents · 50 families</span>\n        <h3>Get everything free. Tell us the truth.</h3>\n        <p>We’re new, and we won’t fake a single review. So here’s the deal: the first 50 families get the 30-Day Reset, The Kid Brain Toolkit and every bonus, free. You do the 30 days and tell us honestly what worked and what didn’t.</p>\n        <p style=\"font-weight:700;margin-bottom:6px\">You get:</p>\n        <ul><li>The 30-Day Reset, free</li><li>The Kid Brain Toolkit and all its bonuses, free</li><li>A direct line to us while you do it</li><li>A say in what we make next</li></ul>\n        <p style=\"font-weight:700;margin:12px 0 6px\">We ask:</p>\n        <ul><li>Do the 30 days, about 10 minutes a day</li><li>Answer 3 short questions on day 7 and day 30</li><li>If it helped, a short review or video, only if you want to</li></ul>\n      </div>\n      <form class=\"inline-form\" data-form=\"founding-parents\">\n        <span class=\"form-title\">Count me in</span>\n        <input type=\"email\" name=\"email\" required placeholder=\"Your email\" aria-label=\"Your email\" autocomplete=\"email\">\n        <label>Your child’s age\n          <select name=\"child_age\" required><option value=\"\">Choose</option><option>4–7</option><option>8–12</option><option>13–17</option><option>More than one kid</option></select>\n        </label>\n        <fieldset style=\"border:0\"><legend style=\"font-weight:700;font-size:15px;margin-bottom:6px\">Happy to record a short video?</legend>\n          <div class=\"radios\"><label><input type=\"radio\" name=\"video\" value=\"yes\" required> Yes</label><label><input type=\"radio\" name=\"video\" value=\"maybe\"> Maybe</label></div>\n        </fieldset>\n        <button class=\"btn btn-main\" type=\"submit\">Apply to be a founding parent</button>\n        <span class=\"ok\">Thank you! We’ll email you soon ✓</span>\n        <small style=\"color:var(--ink-soft)\">We only use your words or video if you say yes in writing. No kids’ faces, names or schools, ever.</small>\n      </form>\n    </div>\n  </div>\n</section>\n\n<section class=\"sec lazy-sec s-white\" id=\"next\" data-c=\"var(--sero)\">\n  <div class=\"wrap\" style=\"max-width:900px\">\n    <div class=\"sec-head\"><h2>What’s coming next</h2><p>Tell us what you want first. Your votes decide what we make next.</p></div>\n    <ul class=\"next-list\">\n      <li><div data-char=\"sero\" data-mood=\"tired\"><svg class=\"ch ch-sero \" viewBox=\"0 0 120 120\" aria-hidden=\"true\" focusable=\"false\"><g class=\"rays\"><line x1=\"104.0\" y1=\"66.0\" x2=\"114.0\" y2=\"66.0\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"95.6\" y1=\"91.9\" x2=\"103.7\" y2=\"97.7\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"73.6\" y1=\"107.8\" x2=\"76.7\" y2=\"117.4\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"46.4\" y1=\"107.8\" x2=\"43.3\" y2=\"117.4\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"24.4\" y1=\"91.9\" x2=\"16.3\" y2=\"97.7\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"16.0\" y1=\"66.0\" x2=\"6.0\" y2=\"66.0\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"24.4\" y1=\"40.1\" x2=\"16.3\" y2=\"34.3\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"46.4\" y1=\"24.2\" x2=\"43.3\" y2=\"14.6\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"73.6\" y1=\"24.2\" x2=\"76.7\" y2=\"14.6\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"95.6\" y1=\"40.1\" x2=\"103.7\" y2=\"34.3\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><g class=\"bob\"><circle cx=\"60\" cy=\"66\" r=\"36\" fill=\"#FFB86B\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M39 60q7 6 14 0M67 60q7 6 14 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"38\" cy=\"72\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><circle cx=\"82\" cy=\"72\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><path d=\"M53 80q7-3 14 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><text x=\"92\" y=\"34\" font-family=\"Bricolage Grotesque,system-ui,sans-serif\" font-weight=\"800\" font-size=\"18\" fill=\"#1B1A33\">z</text><text x=\"104\" y=\"22\" font-family=\"Bricolage Grotesque,system-ui,sans-serif\" font-weight=\"800\" font-size=\"13\" fill=\"#1B1A33\">z</text></g></svg></div><div><h3>Bedtime stories with the crew</h3><p>Short audio stories that help kids wind down. Sero closes the curtains. Corti turns off the alarm.</p></div></li>\n      <li><div data-char=\"teo\"><svg class=\"ch ch-teo \" viewBox=\"0 0 120 120\" aria-hidden=\"true\" focusable=\"false\"><g class=\"bob\"><rect x=\"24\" y=\"30\" width=\"72\" height=\"76\" rx=\"24\" fill=\"#BFE6FF\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><rect x=\"24\" y=\"40\" width=\"72\" height=\"12\" fill=\"#FF5A36\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M96 46l12-6M96 46l12 4\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g class=\"eyes\"><circle cx=\"46\" cy=\"66\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"74\" cy=\"66\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"47.5\" cy=\"67\" r=\"3.2\" fill=\"#1B1A33\"/><circle cx=\"75.5\" cy=\"67\" r=\"3.2\" fill=\"#1B1A33\"/></g><circle cx=\"38\" cy=\"78\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><circle cx=\"82\" cy=\"78\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><path d=\"M48 84q12 9 24 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M24 80q-14-2-14-16M10 64h-6v-8h18v8h-6\" fill=\"#FFD84D\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div><div><h3>“Your brain, your rules”</h3><p>A course for teens themselves: sleep, focus, energy and confidence, in words they use.</p></div></li>\n      <li><div data-char=\"toci\"><svg class=\"ch ch-toci \" viewBox=\"0 0 120 120\" aria-hidden=\"true\" focusable=\"false\"><g class=\"bob\"><path d=\"M60 104C22 80 12 48 34 34c12-7 22 0 26 10 4-10 14-17 26-10 22 14 12 46-26 70z\" fill=\"#FFC6D3\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g class=\"eyes\"><circle cx=\"46\" cy=\"58\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"74\" cy=\"58\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"47.5\" cy=\"59\" r=\"3.2\" fill=\"#1B1A33\"/><circle cx=\"75.5\" cy=\"59\" r=\"3.2\" fill=\"#1B1A33\"/></g><circle cx=\"38\" cy=\"70\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><circle cx=\"82\" cy=\"70\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><path d=\"M50 74q10 9 20 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M22 66q-10 6-6 16M98 66q10 6 6 16\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div><div><h3>The crew in your language</h3><p>The crew are cartoons, so they can learn new voices. Tell us which language you want.</p></div></li>\n    </ul>\n    <form class=\"next-form\" data-form=\"coming-next\">\n      <label><input type=\"checkbox\" name=\"want\" value=\"bedtime-stories\" checked> Bedtime stories</label>\n      <label><input type=\"checkbox\" name=\"want\" value=\"teen-course\"> Teen course</label>\n      <select name=\"language\" aria-label=\"Language\"><option value=\"\">Language: English is fine</option><option>Serbian / Croatian / Bosnian</option><option>German</option><option>Spanish</option><option>French</option><option>Italian</option><option>Other</option></select>\n      <input type=\"email\" name=\"email\" required placeholder=\"Your email\" aria-label=\"Your email\" autocomplete=\"email\">\n      <button class=\"btn btn-main\" type=\"submit\">Tell me first</button>\n      <span class=\"ok\">Got it. You’ll hear from us first ✓</span>\n    </form>\n  </div>\n</section>\n\n<section class=\"sec lazy-sec s-white\" id=\"about\" data-c=\"var(--sero)\">\n  <div class=\"wrap who-card\">\n    <div class=\"avatar\"><div data-char=\"sero\" style=\"width:70%\"><svg class=\"ch ch-sero \" viewBox=\"0 0 120 120\" aria-hidden=\"true\" focusable=\"false\"><g class=\"rays\"><line x1=\"104.0\" y1=\"66.0\" x2=\"114.0\" y2=\"66.0\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"95.6\" y1=\"91.9\" x2=\"103.7\" y2=\"97.7\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"73.6\" y1=\"107.8\" x2=\"76.7\" y2=\"117.4\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"46.4\" y1=\"107.8\" x2=\"43.3\" y2=\"117.4\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"24.4\" y1=\"91.9\" x2=\"16.3\" y2=\"97.7\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"16.0\" y1=\"66.0\" x2=\"6.0\" y2=\"66.0\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"24.4\" y1=\"40.1\" x2=\"16.3\" y2=\"34.3\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"46.4\" y1=\"24.2\" x2=\"43.3\" y2=\"14.6\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"73.6\" y1=\"24.2\" x2=\"76.7\" y2=\"14.6\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><line x1=\"95.6\" y1=\"40.1\" x2=\"103.7\" y2=\"34.3\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g><g class=\"bob\"><circle cx=\"60\" cy=\"66\" r=\"36\" fill=\"#FFB86B\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M38 60q8-8 16 0M66 60q8-8 16 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"38\" cy=\"72\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><circle cx=\"82\" cy=\"72\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><path d=\"M50 78q10 8 20 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div><small>your photo here</small></div>\n    <div>\n      <h2 style=\"margin-bottom:16px\">Who’s behind this</h2>\n      <p>Parents, just like you. We wanted to understand what was really going on behind the meltdowns and the 10 p.m. burst of energy. So we turned the science into characters any parent, and any kid, can follow. <span class=\"draft\">your story goes here</span></p>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"site-foot\" id=\"site-foot\">\n  <div class=\"wrap\">\n    <div>\n      <a href=\"/\" class=\"logo\" aria-label=\"Little Brain Crew home\"><img class=\"logo-img\" src=\"/assets/brand/lbc-logo-horizontal-white.svg\" alt=\"\" width=\"133\" height=\"48\"></a>\n      <p style=\"margin-top:12px;max-width:340px\">The crew inside your kid’s brain, made simple. <a href=\"mailto:hello@littlebraincrew.com\" style=\"color:#fff\">hello@littlebraincrew.com</a></p>\n      <a href=\"/support\" class=\"support-link\"><span aria-hidden=\"true\">♥</span> Support the crew · soon</a>\n    </div>\n    <nav aria-label=\"Footer\"><a href=\"/#plans\">Plans</a><a href=\"/pricing\">The 30-Day Reset</a><a href=\"/pricing#club\">Crew Club</a><a href=\"/ask\">Ask the crew</a><a href=\"/free\">Free tips &amp; stickers</a><a href=\"/gift\">Give it as a gift</a><a href=\"/shop\">Shop</a><a href=\"/schools\">For schools</a><a href=\"/founding\">Founding parents</a><a href=\"/affiliate\">Affiliate program</a><a href=\"/faq\">Parent FAQ</a><a href=\"/privacy\">Privacy</a><a href=\"/terms\">Terms</a></nav>\n    <div class=\"foot-cols\">\n      <nav aria-label=\"Learn about the crew\">\n        <h2>Learn</h2>\n        <a href=\"/crew\">Meet the crew</a>\n        <a href=\"/brain-chemicals\">Brain chemicals</a>\n        <a href=\"/brain-parts\">Brain parts</a>\n        <a href=\"/habits\">Habits</a>\n        <a href=\"/ages\">Ages</a>\n        <a href=\"/glossary\">Glossary</a>\n      </nav>\n      <nav aria-label=\"Answers for parents\">\n        <h2>Answers</h2>\n        <a href=\"/why\">Why does my kid…</a>\n        <a href=\"/what-to-say\">What to say</a>\n        <a href=\"/myths\">Myths</a>\n        <a href=\"/guides\">Guides</a>\n        <a href=\"/learn\">All guides</a>\n      </nav>\n      <nav aria-label=\"About Little Brain Crew\">\n        <h2>About</h2>\n        <a href=\"/about\">About</a>\n        <a href=\"/editorial-policy\">How we write</a>\n        <a href=\"/sources\">Sources</a>\n      </nav>\n    </div>\n    <p class=\"foot-note\">For learning only. Not medical advice. We don’t sell supplements, hormones, medicine or body products. If you are worried about your child’s health, talk to your pediatrician.</p>\n  </div>\n</footer>"
