2.8c1.6 1.3 3 2.8 4.3 4.6 3-4.6 6.4-8.6 10.6-11.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n  </defs>\n</svg>\n\n<div class=\"progress\" aria-hidden=\"true\"><i id=\"progress\"></i></div>\n<header class=\"top\">\n  <div class=\"wrap\">\n    <a href=\"/\" class=\"logo\" aria-label=\"Little Brain Crew home\"><img class=\"logo-img on-light\" src=\"/assets/brand/lbc-logo-horizontal.svg\" alt=\"\" width=\"133\" height=\"48\"><img class=\"logo-img on-dark\" src=\"/assets/brand/lbc-logo-horizontal-white.svg\" alt=\"\" width=\"133\" height=\"48\"></a>\n    <nav class=\"learn-nav\" aria-label=\"Learn\">\n      <a href=\"/crew\">Meet the crew</a>\n      <a href=\"/why\">Why does my kid…</a>\n      <a href=\"/what-to-say\">What to say</a>\n      <a href=\"/myths\">Myths</a>\n      <a href=\"/learn\">All guides</a>\n    </nav>\n    <details class=\"learn-menu\">\n      <summary>Learn</summary>\n      <div class=\"learn-pop\">\n        <a href=\"/crew\">Meet the crew</a>\n        <a href=\"/why\">Why does my kid…</a>\n        <a href=\"/what-to-say\">What to say</a>\n        <a href=\"/myths\">Myths</a>\n        <a href=\"/learn\">All guides</a>\n      </div>\n    </details>\n    <div class=\"top-right\">\n      <div class=\"toggle\" role=\"group\" aria-label=\"I am a\">\n        <button type=\"button\" aria-pressed=\"true\" data-who=\"mom\"><span class=\"long\">I’m a </span>mom</button>\n        <button type=\"button\" aria-pressed=\"false\" data-who=\"dad\"><span class=\"long\">I’m a </span>dad</button>\n      </div>\n      <a href=\"/#plans\" class=\"btn btn-main\">See the plans</a>\n    </div>\n  </div>\n</header>\n\n<main id=\"main\">\n\n<section class=\"sec lazy-sec s-white\" id=\"tips\" data-c=\"var(--endo)\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <h2><span class=\"circled\">Free<svg class=\"hd draw\" viewBox=\"0 0 120 60\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><ellipse pathLength=\"1\" cx=\"60\" cy=\"30\" rx=\"56\" ry=\"25\" transform=\"rotate(-4 60 30)\"/></svg></span> tips for<br>tonight.</h2>\n      <p>Six hard moments, six small fixes. Save the ones you need.</p>\n    </div>\n    <p class=\"swipe-hint\">swipe →</p>\n    <div class=\"tips-row\" id=\"tips-row\"></div>\n    <div class=\"tips-cta\">\n      <div><h3>Want 15 ways to end screen time without tears?</h3><p style=\"color:var(--ink-soft);margin-top:8px\">A free, printable list. One email, no spam.</p></div>\n      <form class=\"lead-form\" data-form=\"free-screen-list\">\n        <input type=\"email\" name=\"email\" required placeholder=\"Your email\" aria-label=\"Your email\" autocomplete=\"email\">\n        <button class=\"btn btn-main\" type=\"submit\">Send me the list</button>\n        <span class=\"ok\">Almost done: tap the link in the email we just sent ✓</span>\n      </form>\n    </div>\n  </div>\n</section>\n\n<section class=\"sec lazy-sec s-plain\" id=\"stickers\" data-c=\"var(--toci)\">\n  <div class=\"wrap st-box\">\n    <div class=\"st-grid\" data-reveal>\n      <img src=\"/stickers/01-dopa-happy.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Dopa: Great job!\">\n      <img src=\"/stickers/02-dopa-tired.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Dopa: 5 more min?\">\n      <img src=\"/stickers/03-sero-main.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Sero: Good morning!\">\n      <img src=\"/stickers/04-sero-tired.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Sero: Bedtime!\">\n      <img src=\"/stickers/05-endo-main.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Endo: Let’s move!\">\n      <img src=\"/stickers/06-endo-tired.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Endo: Need a break\">\n      <img src=\"/stickers/07-toci-main.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Toci: Hug?\">\n      <img src=\"/stickers/08-toci-tired.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Toci: Miss you\">\n      <img src=\"/stickers/09-corti-happy.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Corti: Deep breath\">\n      <img src=\"/stickers/10-corti-main.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Corti: Too loud!\">\n      <img src=\"/stickers/11-teo-main.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Teo: Game on!\">\n      <img src=\"/stickers/12-teo-tired.webp\" width=\"160\" height=\"160\" loading=\"lazy\" decoding=\"async\" alt=\"Sticker: Teo: Sleep first\">\n    </div>\n    <div>\n      <span class=\"kick\">free gift</span>\n      <h2>The free crew sticker pack</h2>\n      <p class=\"lede\" style=\"margin:12px 0 24px\">12 stickers for WhatsApp and Telegram. Send “5 more min?” or “Hug?” to your family.</p>\n      <form class=\"lead-form\" data-form=\"sticker-pack\">\n        <input type=\"email\" name=\"email\" required placeholder=\"Your email\" aria-label=\"Your email\" autocomplete=\"email\">\n        <button class=\"btn btn-main\" type=\"submit\">Get the stickers</button>\n      </form>\n      <p class=\"why\" style=\"color:var(--fg-soft)\">We ask for your email so we can send you the stickers and a few tips. Leave anytime.</p>\n      <div class=\"dl\" id=\"st-dl\"><a class=\"btn\" href=\"/downloads/crew-stickers.zip\" download>Download the stickers (ZIP)</a><small>PNG for Telegram, WebP for WhatsApp sticker apps. Or just send them as pictures.</small></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"sec lazy-sec s-plain\" id=\"challenge\" data-c=\"var(--dopa)\">\n  <div class=\"wrap\">\n    <div class=\"chal\" data-reveal>\n      <div data-char=\"dopa\"><svg class=\"ch ch-dopa \" viewBox=\"0 0 120 120\" aria-hidden=\"true\" focusable=\"false\"><g class=\"bob\"><path d=\"M60 10l5.5 11.5 12.5 1.8-9 8.8 2.1 12.4L60 38.6l-11.1 5.9 2.1-12.4-9-8.8 12.5-1.8z\" fill=\"#FF5A36\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"60\" cy=\"74\" r=\"36\" fill=\"#FFD84D\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><g class=\"eyes\"><circle cx=\"46\" cy=\"68\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"74\" cy=\"68\" r=\"7\" fill=\"#fff\" stroke=\"#1B1A33\" stroke-width=\"2.5\"/><circle cx=\"47.5\" cy=\"69\" r=\"3.2\" fill=\"#1B1A33\"/><circle cx=\"75.5\" cy=\"69\" r=\"3.2\" fill=\"#1B1A33\"/></g><circle cx=\"38\" cy=\"80\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><circle cx=\"82\" cy=\"80\" r=\"5\" fill=\"#FF8FA8\" opacity=\".7\"/><path d=\"M48 84q12 10.8 24 0\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M24 78q-10-8-6-20M96 78q10-8 6-20\" fill=\"none\" stroke=\"#1B1A33\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></g></svg></div>\n      <div>\n        <span class=\"kick\">free · 5 days · 5 minutes a day</span>\n        <h2>The Screen-Off Challenge with Dopa</h2>\n        <p>5 small steps to end screen time without a meltdown. One short email and one small task each day.</p>\n        <div class=\"days\"><span>Day 1 · Notice</span><span>Day 2 · Warn</span><span>Day 3 · Swap</span><span>Day 4 · Win</span><span>Day 5 · Celebrate</span></div>\n      </div>\n      <form class=\"inline-form\" data-form=\"screen-off-challenge\">\n        <span class=\"form-title\">Join the next round</span>\n        <input type=\"email\" name=\"email\" required placeholder=\"Your email\" aria-label=\"Your email\" autocomplete=\"email\">\n        <button class=\"btn btn-main\" type=\"submit\">I’m in</button>\n        <span class=\"ok\">Almost in: tap the link in the email we just sent ✓</span>\n        <small style=\"color:var(--ink-soft)\">Free. Leave anytime.</small>\n      </form>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"site-foot\" id=\"site-foot\">\n  <div class=\"wrap\">\n    <div>\n      <a href=\"/\" class=\"logo\" aria-label=\"Little Brain Crew home\"><img class=\"logo-img\" src=\"/assets/brand/lbc-logo-horizontal-white.svg\" alt=\"\" width=\"133\" height=\"48\"></a>\n      <p style=\"margin-top:12px;max-width:340px\">The crew inside your kid’s brain, made simple. <a href=\"mailto:hello@littlebraincrew.com\" style=\"color:#fff\">hello@littlebraincrew.com</a></p>\n    </div>\n    <nav aria-label=\"Footer\"><a href=\"/#plans\">Plans</a><a href=\"/pricing\">The 30-Day Reset</a><a href=\"/pricing#club\">Crew Club</a><a href=\"/ask\">Ask the crew</a><a href=\"/free\">Free tips &amp; stickers</a><a href=\"/gift\">Give it as a gift</a><a href=\"/shop\">Shop</a><a href=\"/schools\">For schools</a><a href=\"/founding\">Founding parents</a><a href=\"/affiliate\">Affiliate program</a><a href=\"/faq\">Parent FAQ</a><a href=\"/privacy\">Privacy</a><a href=\"/terms\">Terms</a></nav>\n    <div class=\"foot-cols\">\n      <nav aria-label=\"Learn about the crew\">\n        <h2>Learn</h2>\n        <a href=\"/crew\">Meet the crew</a>\n        <a href=\"/brain-chemicals\">Brain chemicals</a>\n        <a href=\"/brain-parts\">Brain parts</a>\n        <a href=\"/habits\">Habits</a>\n        <a href=\"/ages\">Ages</a>\n        <a href=\"/glossary\">Glossary</a>\n      </nav>\n      <nav aria-label=\"Answers for parents\">\n        <h2>Answers</h2>\n        <a href=\"/why\">Why does my kid…</a>\n        <a href=\"/what-to-say\">What to say</a>\n        <a href=\"/myths\">Myths</a>\n        <a href=\"/guides\">Guides</a>\n        <a href=\"/learn\">All guides</a>\n      </nav>\n      <nav aria-label=\"About Little Brain Crew\">\n        <h2>About</h2>\n        <a href=\"/a